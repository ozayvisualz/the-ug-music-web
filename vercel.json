{
  "buildCommand": "next build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "artist.theugmusic.com" }],
      "destination": "/artist/dashboard"
    }
  ]
}
