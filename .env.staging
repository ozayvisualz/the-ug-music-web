# Database
DATABASE_URL="postgresql://ugmusic:${DB_PASSWORD}@postgres:5432/ugmusic"

# Auth
AUTH_SECRET="${AUTH_SECRET}"
AUTH_URL="https://staging-api.theugmusic.com"
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID="${AUTH_GOOGLE_ID}"
AUTH_GOOGLE_SECRET="${AUTH_GOOGLE_SECRET}"

# MinIO
MINIO_ENDPOINT="minio"
MINIO_PORT=9000
MINIO_ACCESS_KEY="${MINIO_ACCESS_KEY}"
MINIO_SECRET_KEY="${MINIO_SECRET_KEY}"
MINIO_BUCKET="ugandan-music"
MINIO_USE_SSL=false
S3_PUBLIC_URL="https://staging-cdn.theugmusic.com"

# Flutterwave
FLW_PUBLIC_KEY="${FLW_PUBLIC_KEY}"
FLW_SECRET_KEY="${FLW_SECRET_KEY}"
FLW_ENCRYPTION_KEY="${FLW_ENCRYPTION_KEY}"
FLW_WEBHOOK_SECRET="${FLW_WEBHOOK_SECRET}"

# App
NEXT_PUBLIC_APP_URL="https://staging.theugmusic.com"
NEXT_PUBLIC_APP_NAME="TheUgMusic"
NEXT_PUBLIC_CURRENCY="UGX"
NEXT_PUBLIC_CURRENCY_SYMBOL="UGX"

# Redis
REDIS_URL="redis://redis:6379"

# Audio Processing
MAX_UPLOAD_SIZE_MB=50
HLS_SEGMENT_DURATION=10

# Ads
AD_CPM_RATE=5000

# Revenue Splits
REVENUE_SPLIT_STREAMING_ARTIST=70
REVENUE_SPLIT_DOWNLOAD_ARTIST=70
REVENUE_SPLIT_TIP_ARTIST=95
REVENUE_SPLIT_MERCH_ARTIST=85
REVENUE_SPLIT_TICKET_ARTIST=90
REVENUE_SPLIT_SUBSCRIPTION_ARTIST=70

# Subscriptions
PLAN_MONTHLY=10000
PLAN_QUARTERLY=25000
PLAN_ANNUAL=80000
MIN_WITHDRAWAL_AMOUNT=50000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoring
SENTRY_DSN="${SENTRY_DSN}"
LOG_LEVEL=debug
